  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.98, g: 0.97, b: 0.94, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<b><size=22><color=#FBBF24>1. THE DATE (10 SLOTS)</color></size></b>\nYou
    are sitting across from Maya at an outdoor caf\xE9. Each slot presents a conversational
    moment.\n\n<b><size=22><color=#38BDF8>2. PHASE 1: RTS INTERVENTION (20 SECONDS)</color></size></b>\nDrag
    4 core emotional affects onto your 5 internal organs to shape your thoughts:\n
    \u2022 <color=#60A5FA><b>Calm</b></color>: Stabilizes heart rate, protects composure,
    grounds speech.\n \u2022 <color=#C084FC><b>Anxiety</b></color>: Heightens alertness
    & sharp responses, but stresses composure.\n \u2022 <color=#FDE047><b>Confidence</b></color>:
    Drives playful banter and boldness; shines when Maya teases.\n \u2022 <color=#F87171><b>Attraction</b></color>:
    Deepens intimacy and vulnerability; creates romantic sparks.\n<b>Organs:</b>
    Brain (Logic), Voice (Speech), Heart (Passion), Body (Presence), Lungs (Generates
    Oxygen).\n<i>*Note: Deploying affects costs 15 Oxygen (supplied by Lungs).</i>\n\n<b><size=22><color=#4ADE80>3.
    PHASE 2: YOUR SPOKEN WORDS (5 SECONDS)</color></size></b>\nYour autonomic organ
    balance dictates what words and tone you actually speak aloud!\n\n<b><size=22><color=#F472B6>4.
    PHASE 3: MAYA'S REACTION & THE VERDICT (5 SECONDS)</color></size></b>\nWatch
    Maya's facial micro-expressions. If Composure hits 0, you suffer an autonomic
    Meltdown!\nReach <b>Connection Tier 3 or 4</b> by Slot 10 to secure a second
    date\u2014or even be invited over!"
