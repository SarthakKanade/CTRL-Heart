  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.98, g: 0.97, b: 0.94, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<b><size=22><color=#FBBF24>1. EXPANDED ROSTER & NEW CHARACTERS</color></size></b>\n\u2022
    Adding fully written <b>Male and Female</b> dating routes, each with unique dialogue,
    neuroses, and emotional quirks.\n\u2022 <i>(Community Demands Acknowledged):</i>
    Yes, by overwhelming request... <b>Goth Girls, Dominant Mommys, & Soft Femboys</b>
    are currently undergoing biological stress simulations. Our lab is on it. Stay
    tuned!\n\n<b><size=22><color=#38BDF8>2. FULL VOICE-OVER (VOICE ACTING)</color></size></b>\n\u2022
    Expressive voice acting for both your date partner and your panicked internal
    monologue.\n\u2022 Dynamic audio cues that react to your heart rate\u2014nervous
    stutters, bold quips, and breathless pauses!\n\n<b><size=22><color=#4ADE80>3.
    DATE LOCATION SELECTION</color></size></b>\n\u2022 Choose your battleground:
    <b>Candlelight Bistro, Retro Arcade, Rainy Park Bench, or Bustling Night Market</b>.\n\u2022
    Each venue brings unique environmental stressors (e.g. Arcades drain Focus; Fancy
    Dining drains Composure)!\n\n<b><size=22><color=#F472B6>4. MORE ORGANS, EMOTIONS
    & MINI-GAMES</color></size></b>\n\u2022 Introducing <b>The Stomach</b> (Butterflies
    vs Acid Reflux) and <b>Sweaty Palms</b> as active organ nodes!\n\u2022 Secret
    mixture emotions, unlockable outfits, and 10+ divergent branch endings."
